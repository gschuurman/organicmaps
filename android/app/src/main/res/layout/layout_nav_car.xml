<?xml version="1.0" encoding="utf-8"?>
<!-- Android Automotive OS, like Google Maps there: the turn card at the top and the trip card at the bottom, right of
     the map controls column (map_buttons_layout_car_navigation.xml). On the left, the driver side, in every language
     (ltr). Based on layout-land/layout_nav.xml, NavigationController and NavMenu need the same ids. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/navigation_frame"
  android:layoutDirection="ltr"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <include layout="@layout/layout_nav_top_car" />

  <androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/nav_bottom_sheet_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
      android:id="@+id/nav_bottom_sheet_background"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#99000000"
      android:clickable="true"
      android:focusable="true"
      android:visibility="gone"
      tools:visibility="visible" />

    <!-- Transparent: the trip card floats inside it, see layout_nav_bottom_car.xml -->
    <FrameLayout
      android:id="@+id/nav_bottom_sheet"
      android:layout_width="@dimen/car_nav_panel_width"
      android:layout_marginStart="@dimen/car_controls_column_width"
      android:layout_height="wrap_content"
      android:layout_gravity="start"
      app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

      <include layout="@layout/layout_nav_bottom_car" />
    </FrameLayout>

  </androidx.coordinatorlayout.widget.CoordinatorLayout>

  <View
    android:id="@+id/nav_bottom_sheet_nav_bar"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginStart="@dimen/car_controls_column_width"
    android:layout_gravity="bottom|start" />
</FrameLayout>
