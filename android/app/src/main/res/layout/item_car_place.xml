<?xml version="1.0" encoding="utf-8"?>
<!-- Android Automotive OS: a place in the places panel, see CarPlacesPanel -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?selectableItemBackground"
  android:focusable="true"
  android:gravity="center_vertical"
  android:minHeight="@dimen/car_touch_target"
  android:orientation="horizontal"
  android:paddingHorizontal="@dimen/car_margin"
  android:paddingVertical="@dimen/car_margin_half">

  <ImageView
    android:id="@+id/icon"
    android:layout_width="@dimen/car_place_icon_size"
    android:layout_height="@dimen/car_place_icon_size"
    android:background="@drawable/bg_car_place_icon"
    android:importantForAccessibility="no"
    android:padding="@dimen/car_margin_half"
    app:tint="?iconTint"
    tools:src="@drawable/ic_search_recent" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/car_margin"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAppearance="@style/MwmTextAppearance.Car"
      tools:text="Ramo Hall" />

    <TextView
      android:id="@+id/subtitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAppearance="@style/MwmTextAppearance.Car.Secondary"
      tools:text="2.8 mi" />
  </LinearLayout>
</LinearLayout>
