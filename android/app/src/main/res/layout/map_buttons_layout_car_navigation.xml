<?xml version="1.0" encoding="utf-8"?>
<!-- Android Automotive OS, like Google Maps there: the map controls in a column along the start edge, the turn
     card and the trip card right of it (layout_nav_car.xml). Search is kept low so that the search along the route
     unfolds over the map, under the turn card. -->
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipChildren="false"
  android:clipToPadding="false"
  tools:background="@color/bg_primary">
  <View
    android:id="@+id/touch_interceptor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    tools:visibility="visible" />
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/map_buttons_inner_left"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/car_controls_column_padding"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/btn_bookmarks"
      style="@style/MwmWidget.MapButton.Car"
      android:contentDescription="@string/bookmarks"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:srcCompat="@drawable/ic_bookmarks_and_tracks" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/track_recording_status"
      style="@style/MwmWidget.MapButton.Car"
      android:layout_marginTop="@dimen/car_spacing"
      android:tint="@color/accent_color_selector"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/btn_bookmarks"
      app:srcCompat="@drawable/ic_track_recording_status" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/btn_search"
      style="@style/MwmWidget.MapButton.Car"
      android:layout_marginBottom="@dimen/car_spacing"
      android:contentDescription="@string/search"
      app:layout_constraintBottom_toTopOf="@+id/zoom_buttons_container"
      app:layout_constraintStart_toStartOf="parent"
      app:srcCompat="@drawable/ic_search" />
    <!-- Search along the route, unfolds towards the end from the search button -->
    <LinearLayout
      android:id="@+id/search_frame"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/car_spacing"
      android:background="?searchLayoutBackground"
      android:orientation="horizontal"
      android:padding="@dimen/car_margin_half"
      android:theme="?navButtonsThemeRect"
      android:visibility="invisible"
      app:layout_constraintBottom_toBottomOf="@id/btn_search"
      app:layout_constraintStart_toEndOf="@id/btn_search"
      app:layout_constraintTop_toTopOf="@id/btn_search"
      tools:visibility="visible">
      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/search_fuel"
        style="@style/MwmWidget.MapButton.Car"
        android:contentDescription="@string/category_fuel"
        app:srcCompat="@drawable/ic_routing_fuel_on" />
      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/search_ev_charging"
        style="@style/MwmWidget.MapButton.Car"
        android:layout_marginStart="@dimen/car_spacing"
        android:contentDescription="@string/category_ev_charging"
        app:srcCompat="@drawable/ic_routing_ev_charging_on" />
      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/search_parking"
        style="@style/MwmWidget.MapButton.Car"
        android:layout_marginStart="@dimen/car_spacing"
        android:contentDescription="@string/category_parking"
        app:srcCompat="@drawable/ic_routing_parking_on" />
      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/search_eat"
        style="@style/MwmWidget.MapButton.Car"
        android:layout_marginStart="@dimen/car_spacing"
        android:contentDescription="@string/category_eat"
        app:srcCompat="@drawable/ic_routing_eat_on" />
      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/search_food"
        style="@style/MwmWidget.MapButton.Car"
        android:layout_marginStart="@dimen/car_spacing"
        android:contentDescription="@string/category_shopping"
        app:srcCompat="@drawable/ic_routing_food_on" />
      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/search_atm"
        style="@style/MwmWidget.MapButton.Car"
        android:layout_marginStart="@dimen/car_spacing"
        android:contentDescription="@string/category_atm"
        app:srcCompat="@drawable/ic_routing_atm_on" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/zoom_buttons_container"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/car_spacing"
      android:orientation="vertical"
      app:layout_constraintBottom_toTopOf="@+id/my_position"
      app:layout_constraintStart_toStartOf="parent">
      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_zoom_in"
        style="@style/MwmWidget.MapButton.Car"
        android:layout_marginBottom="@dimen/car_spacing"
        android:contentDescription="@string/zoom_in"
        app:srcCompat="@drawable/ic_plus" />
      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_zoom_out"
        style="@style/MwmWidget.MapButton.Car"
        android:contentDescription="@string/zoom_out"
        app:srcCompat="@drawable/ic_minus" />
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/my_position"
      style="@style/MwmWidget.MapButton.Car"
      android:contentDescription="@string/core_my_position"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
